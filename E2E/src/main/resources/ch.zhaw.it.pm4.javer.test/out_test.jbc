.code
_main:
ENTER, 4              // local a: struct A ref

DPRINTS, main_prefix

// let struct A a = call initA("string", 1)
PUSHR, str_0          // string literal as data-ref
PUSHI, 1
CALL, _initA, 8
FSTORE4, 0

// print a.s
DPRINTS, s_label
FLOAD4, 0             // a
PUSHI, 0              // A.s offset
HLOAD4                // data/string ref
HPRINTS

// print a.i
DPRINTS, i_label
FLOAD4, 0             // a
PUSHI, 4              // A.i offset
HLOAD4
PRINTI

DPRINTS, newline
RET

_initA:
ENTER, 4              // local a

// let struct A a = new struct A
PUSHI, 8              // string ref 4 + int 4
NEW
FSTORE4, 0

// a.s = s
FLOAD4, 0
PUSHI, 0
FLOAD4, -8
HSTORE4

// a.i = i
FLOAD4, 0
PUSHI, 4
FLOAD4, -4
HSTORE4

// return a
FLOAD4, 0
RETI

.data
str_0 2 0073,0074,0072,0069,006E,0067,0000
main_prefix 2 0061,0020,003D,0020,0000
s_label 2 007B,0020,0073,003A,0020,0000
i_label 2 002C,0020,0069,003A,0020,0000
newline 2 0020,007D,000A,0000