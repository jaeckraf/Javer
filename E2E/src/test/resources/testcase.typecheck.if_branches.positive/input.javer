fn void main() {

    // boolean literal
    if (true) {
        call prints("boolean true branch\n");
    }

    if (false) {
        call prints("should not execute\n");
    } else {
        call prints("boolean false branch\n");
    }

    // integer literal (non-zero = true)
    if (5) {
        call prints("non-zero integer branch\n");
    }

    // integer literal (zero = false)
    if (0) {
        call prints("should not execute\n");
    } else {
        call prints("zero evaluated as false\n");
    }

    return;
}