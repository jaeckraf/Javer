fn void main() {

    let struct A a = new struct A;
    a.d = 3;
    a.d1 = 6;

    call printf(a.d);
    call printf(a.d1);

    let struct B bb = cast (struct B) a;
    bb.d = 0.0;

    call printf(a.d);
    call printf(a.d1);

}

struct A {
    int d;
    int d1;
}

struct B {
    double d;
}

fn void printf(int d) {
    call printi(d);
    call prints("\n");
}