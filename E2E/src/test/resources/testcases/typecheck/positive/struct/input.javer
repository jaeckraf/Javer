struct Person {
    int age;
    string name;
    boolean student;
}

fn void main() {
    let struct Person p = new struct Person;

    p.age = 21;
    p.name = "Surajeev";
    p.student = true;

    let int age = p.age;
    let string name = p.name;
    let boolean student = p.student;

    if (p.student) {
        call prints("student\n");
    }

    return;
}