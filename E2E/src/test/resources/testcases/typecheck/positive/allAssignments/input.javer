fn void main() {

    // simple assignment
    let int x = 10;
    x = 20;

    // arithmetic assignment operators
    x += 5;
    x -= 2;
    x *= 3;
    x /= 2;
    x %= 4;

    // bitwise assignment operators
    x |= 1;
    x &= 7;
    x ^= 2;

    // shift assignment operators
    x <<= 1;
    x >>= 1;

    // double assignment operators
    let double d = 3.14;
    d = 2.5;
    d += 5;
    d -= 1.5;
    d *= 2;
    d /= 2;

    // int -> double still valid
    d += x;

    // chained simple assignment
    let int a = 0;
    let int b = 0;
    let int c = 0;

    a = b = c = 42;

    // expression assignment
    x += (5 * 2);
    x -= (3 + 1);
    x *= (2 + 1);
    x /= (6 / 2);
    x %= (5 - 1);

    call prints("assignment operator test passed\n");

    return;
}