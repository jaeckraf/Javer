fn void main() {

    let int x = 10;
    let int y = 5;

    // comparison expression
    if (x > y) {
        call prints("x greater than y\n");
    }

    // logical expression
    if (x > 0 && y < 10) {
        call prints("logical expression\n");
    }

    // boolean variable
    let boolean flag = true;

    if (flag) {
        call prints("flag true\n");
    }

    // equality expression
    if (x == 10) {
        call prints("equal\n");
    }

    return;
}