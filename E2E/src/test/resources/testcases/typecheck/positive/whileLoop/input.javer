fn void main() {

    let int x = 0;

    // normal boolean expression
    while (x < 5) {
        x = x + 1;
    }

    let boolean running = true;

    // boolean variable
    while (running) {
        running = false;
    }

    // complex boolean expression
    while (x >= 0 && x < 10) {
        x = x + 1;
    }
    call prints("Test Success");
    return;
}