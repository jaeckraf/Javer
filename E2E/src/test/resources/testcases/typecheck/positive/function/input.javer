fn int add(int a, int b) {
    return a + b;
}

fn double divide(double a, double b) {
    return a / b;
}

fn boolean isPositive(int value) {
    return value > 0;
}

fn char firstLetter() {
    return 'A';
}

fn string greeting() {
    return "hello";
}

fn void printMessage() {
    call prints("inside function\n");
    return;
}

fn int nestedCall(int x) {
    return call add(x, 10);
}

fn void main() {

    // normal function calls
    let int sum = call add(5, 3);

    let double result = call divide(10.0, 2.0);

    let boolean positive = call isPositive(5);

    let char letter = call firstLetter();

    let string text = call greeting();

    // void function call
    call printMessage();

    // nested function call
    let int nested = call nestedCall(5);

    // expression using function result
    let int expression = call add(1, 2) * 3;

    // implicit int -> double
    let double converted = call add(2, 3);

    call prints("positive function test completed\n");

    return;
}