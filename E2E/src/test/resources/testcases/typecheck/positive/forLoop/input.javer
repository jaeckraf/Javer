fn void main() {

    // normal boolean condition
    for (let int i = 0; i < 10; i = i + 1) {
        call prints("loop\n");
    }

    // boolean variable condition
    let boolean running = true;

    for (let int j = 0; running; j = j + 1) {
        running = false;
    }

    // complex boolean expression
    for (let int x = 0; x < 5 && x >= 0; x = x + 1) {
        call prints("complex condition\n");
    }

    return;
}