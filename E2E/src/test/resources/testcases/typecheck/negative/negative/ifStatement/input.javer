fn void main() {

    let string text = "hello";
    let char letter = 'A';
    let int[] numbers = {1, 2, 3};

    // string condition
    if (text) {
        call prints("invalid\n");
    }

    // char condition
    if (letter) {
        call prints("invalid\n");
    }

    // array condition
    if (numbers) {
        call prints("invalid\n");
    }

    return;
}