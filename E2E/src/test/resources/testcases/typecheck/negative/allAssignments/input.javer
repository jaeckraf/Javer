fn void main() {

    let int x = 10;
    let double d = 3.14;
    let boolean b = true;
    let string s = "hello";
    let char c = 'A';

    // simple wrong assignments
    x = true;
    b = 1;
    s = 5;
    c = "B";

    // arithmetic assignment misuse
    x += true;
    x -= "2";
    x *= false;
    x /= "hello";
    x %= 2.5;

    // double cannot receive string / boolean
    d += "x";
    d -= true;
    d *= s;
    d /= b;

    // boolean cannot use arithmetic assignment
    b += 1;
    b -= false;

    // string cannot use arithmetic assignment
    s += 1;
    s -= "x";

    // char cannot use arithmetic assignment unless your language allows it
    c += 1;
    c -= 'A';

    // bitwise only valid for int
    x &= true;
    x |= "1";
    x ^= false;

    d &= 1;
    b |= true;
    s ^= "x";

    // shifts only valid for int << int / int >> int
    x <<= true;
    x >>= "2";

    d <<= 1;
    b >>= 1;

    return;
}