fn void main() {

    let string text = "hello";
    let char letter = 'A';
    let int[] numbers = {1, 2, 3};

    // string condition
    for (let int i = 0; text; i = i + 1) {
        call prints("invalid\n");
	break;
    }

    // char condition
    for (let int j = 0; letter; j = j + 1) {
        call prints("invalid\n");
	break;
    }

    // array condition
    for (let int k = 0; numbers; k = k + 1) {
        call prints("invalid\n");
	break;
    }

    return;
}