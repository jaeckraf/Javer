struct Person {
    int age;
    string name;
    boolean student;
}

fn void main() {
    let struct Person p = new struct Person;

    // wrong field assignments
    p.age = "twenty";
    p.name = 123;
    p.student = "true";

    // wrong field reads
    let int wrongAge = p.name;
    let string wrongName = p.student;
    let boolean wrongStudent = p.age;

    // unknown field
    p.height = 180;

    // struct field used in invalid expression
    let int invalidExpression = p.student + 1;

    // non-boolean field as condition
    if (p.name) {
        call prints("invalid\n");
    }

    return;
}