fn void main() {
    let int truncated = cast(int) 3.9;
    call printi(truncated);
    call prints("\n");

    let double widened = cast(double) 7;
    let int narrowed = cast(int) widened;
    call printi(narrowed);
    call prints("\n");

    let string text = "ok";
    let int address = cast(int) text;
    let string again = cast(string) address;
    call prints(again);
    call prints("\n");
}
