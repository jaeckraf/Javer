fn void main() {
    call dump("inline", 1, 2, 3);
    call dump("empty");

    let int[] values = {4, 5};
    call dump("array", values);
}

fn void dump(string label, int... values) {
    call prints(label);
    call prints(":");
    call printi(values.length);

    for (let int i = 0; i < values.length; i++) {
        call prints(" ");
        call printi(values[i]);
    }
    call prints("\n");
}
