.code
_factorial:
ENTER, 0
FLOAD4, -4
PUSHI, 1
ILE
JUMPF, if_else_0
PUSHI, 1
RETI
if_else_0:
FLOAD4, -4
FLOAD4, -4
PUSHI, 1
ISUB
CALL, _factorial, 4
IMUL
RETI
_main:
ENTER, 0
PUSHI, 0
CALL, _factorial, 4
PRINTI
PUSHI, 1
CALL, _factorial, 4
PRINTI
PUSHI, 5
CALL, _factorial, 4
PRINTI
PUSHI, 7
CALL, _factorial, 4
PRINTI
RET

.data
