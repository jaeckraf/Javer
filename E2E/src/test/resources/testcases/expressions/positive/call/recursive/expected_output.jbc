.code
_factorial:
ENTER, 0
LOCAL, 16
LOAD4
PUSHI, 1
ILE
JUMPF, if_else_0
PUSHI, 1
RET, 4
if_else_0:
LOCAL, 16
LOAD4
LOCAL, 16
LOAD4
PUSHI, 1
ISUB
CALL, _factorial, 4
IMUL
RET, 4
_main:
ENTER, 0
PUSHI, 0
CALL, _factorial, 4
PRINTI
PUSHI, 1
CALL, _factorial, 4
PRINTI
PUSHI, 5
CALL, _factorial, 4
PRINTI
PUSHI, 7
CALL, _factorial, 4
PRINTI
RET, 0

.data
