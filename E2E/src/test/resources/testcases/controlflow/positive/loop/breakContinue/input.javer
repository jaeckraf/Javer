fn void main() {

    while(true) {
        break;
        continue;
    }

    do {
        break;
    } while(true);
    do {
        continue;
    } while(false);

    for(;;) {
        break;
    }

    for(;false;) {
        continue;
    }

    for(;;) {
        for(;;) {
            break;
        }
        break;
    }


	return;
}
