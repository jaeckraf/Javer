fn void main() {
    call prints("Testing string switch:\n");
    switch ("b") {
        case "a":
            call prints("Matched A (FAIL)\n");
        case "b":
            call prints("Matched B\n");
        case "c":
            call prints("Matched C (FAIL - fell through!)\n");
        default:
            call prints("Matched Default (FAIL)\n");
    }
    call prints("Switch ended.\n");
}