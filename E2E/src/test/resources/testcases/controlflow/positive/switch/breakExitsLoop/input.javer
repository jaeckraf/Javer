fn void main() {
    let int i = 0;
    call prints("Testing break inside switch:\n");
    while (i < 5) {
        switch (i) {
            case 0:
                call prints("Iteration 0\n");
            case 1:
                call prints("Iteration 1\n");
            case 2: {
                call prints("Iteration 2 - Breaking out of the WHILE loop now!\n");
                break; // This should exit the 'while' loop
            }
            default:
                call prints("FAIL - Loop did not break!\n");
        }
        i = i + 1;
    }
    call prints("Loop ended successfully.\n");
}