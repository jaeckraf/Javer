fn void main() {
    call prints("Testing char switch with multi-label and block:\n");
    let char c = 'y';
    switch (c) {
        case 'x': {
            call prints("Matched x (FAIL)\n");
        }
        case 'y', 'z': {
            call prints("Matched y or z\n");
            call prints("Char is ");
            call printc('y');
            call prints("\n");
        }
        default:
            call prints("Matched Default (FAIL)\n");
    }
    call prints("Switch ended.\n");
}