fn void main() {
    call prints("Testing double switch:\n");
    switch (3.14) {
        case 1.0: {
            call prints("Matched 1.0 (FAIL)\n");
        }
        case 3.14: {
            call prints("Matched Pi\n");
            call prints("Value: ");
            call printd(3.14);
            call prints("\n");
        }
        default: {
            call prints("Matched Default (FAIL)\n");
        }
    }
    call prints("Switch ended.\n");
}