<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ch.zhaw.it.pm4.javer.application.GuiController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <TextArea fx:id="consoleInput"
              minHeight="120.0"
              prefHeight="300"
              prefWidth="550"
              promptText="Type your code here ...">
        <style>-fx-font-family: &#39;Consolas&#39;; -fx-font-size: 12px;</style>
    </TextArea>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button fx:id="runCompilerAndVMButton"
                onAction="#onRunCompilerAndVMClick"
                text="Run Compiler and VM" />

        <Button fx:id="runCompilerButton"
                onAction="#onRunCompilerClick"
                text="Run Compiler" />

        <Button fx:id="stopCompilerButton"
                onAction="#onStopCompilerClick"
                text="Stop Compiler" />

        <CheckBox fx:id="expertModeOption"
                  text="Expert Mode" />
    </HBox>

    <VBox fx:id="compilerOptionsBox"
          alignment="CENTER_LEFT"
          spacing="6.0"
          visible="false"
          managed="false">
        <Label text="Compiler Options" />

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <CheckBox fx:id="compilerDumpLexerOption" text="Dump Lexer" />
            <CheckBox fx:id="compilerDumpAstOption" text="Dump AST" />
            <CheckBox fx:id="compilerDumpSymbolTableOption" text="Dump Symbol Table" />
            <CheckBox fx:id="compilerLoggingOption" text="Logging (into a logfile)" />
        </HBox>
    </VBox>

    <TextArea fx:id="compilerOutput"
              editable="false"
              minHeight="120.0"
              prefHeight="300"
              prefWidth="550"
              wrapText="true">
        <style>-fx-font-family: &#39;Consolas&#39;; -fx-font-size: 12px;</style>
    </TextArea>

    <HBox alignment="CENTER_LEFT" spacing="10.0">

        <Button fx:id="runVMButton"
                onAction="#onRunVMClick"
                text="Run VM" />

        <Button fx:id="stopVMButton"
                onAction="#onStopVMClick"
                text="Stop VM" />

        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label text="Status / Errors" />

            <TextArea fx:id="statusOutput"
                      editable="false"
                      minHeight="120.0"
                      prefHeight="120"
                      wrapText="true"
                      VBox.vgrow="ALWAYS">
                <style>-fx-font-family: &#39;Consolas&#39;; -fx-font-size: 12px;</style>
            </TextArea>
        </VBox>
    </HBox>

    <VBox fx:id="vmOptionsBox"
          alignment="CENTER_LEFT"
          spacing="6.0"
          visible="false"
          managed="false">
        <Label text="VM Options" />

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label text="Stack Size" />
            <TextField fx:id="vmStackSizeOption"
                       prefWidth="120.0"
                       promptText="1M">
                <style>-fx-font-family: &#39;Consolas&#39;; -fx-font-size: 12px;</style>
            </TextField>
            <CheckBox fx:id="vmDumpOnErrorOption"
                      text="Dump on runtime error" />
        </HBox>

        <TextField fx:id="vmAdditionalArguments"
                   promptText="Additional VM arguments"
                   HBox.hgrow="ALWAYS">
            <style>-fx-font-family: &#39;Consolas&#39;; -fx-font-size: 12px;</style>
        </TextField>
    </VBox>

    <TextArea fx:id="virtualMachineOutput"
              editable="false"
              minHeight="120.0"
              prefHeight="300"
              prefWidth="550"
              wrapText="true">
        <style>-fx-font-family: &#39;Consolas&#39;; -fx-font-size: 12px;</style>
    </TextArea>

</VBox>
